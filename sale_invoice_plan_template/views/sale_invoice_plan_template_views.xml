<odoo>
    <record id="view_sale_invoice_plan_template_list" model="ir.ui.view">
        <field name="name">sale.invoice.plan.template.list</field>
        <field name="model">sale.invoice.plan.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="view_sale_invoice_plan_template_form" model="ir.ui.view">
        <field name="name">sale.invoice.plan.template.form</field>
        <field name="model">sale.invoice.plan.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" invisible="1" />
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="partner_id" placeholder="Invoice address" />
                            <field name="percent" sum="Total" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sale_invoice_plan_template" model="ir.actions.act_window">
        <field name="name">Invoice Plan Templates</field>
        <field name="res_model">sale.invoice.plan.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="menu_sale_invoice_plan_template"
        action="action_sale_invoice_plan_template"
        parent="sale.menu_sales_config"
        sequence="40"
    />
</odoo>
